{
  "name": "touche-pas-au-klaxon/app",
  "description": "Application de partage de trajets avec système de communication responsable",
  "license": "MIT",
  "authors": [
    {
      "name": "TOUCHE PAS AU KLAXON Team",
      "email": "team@klaxon.local"
    }
  ],
  "require": {
    "php": ">=8.1",
    "izniburak/router": "^2.0",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "mockery/mockery": "^1.5",
    "php-parallel-lint/php-parallel-lint": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "KlaxonApp\\": "src/",
      "KlaxonApp\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage",
    "lint": "parallel-lint src/ tests/"
  }
}
