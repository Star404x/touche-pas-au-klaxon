# TOUCHE PAS AU KLAXON - Environment Configuration

# Application
APP_NAME=TOUCHE_PAS_AU_KLAXON
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=klaxon_db
DB_USER=root
DB_PASSWORD=

# Frontend
FRONTEND_URL=/
CSS_PATH=/css/app.css
JS_PATH=/js

# Session
SESSION_LIFETIME=3600
SESSION_COOKIE_SECURE=false  # true en production (HTTPS)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Security
BCRYPT_ROUNDS=12
CSRF_TOKEN_LENGTH=32

# Features
ENABLE_REGISTRATION=false
ENABLE_ADMIN_PANEL=true
MAINTENANCE_MODE=false

# Logging
LOG_LEVEL=error
LOG_PATH=var/logs

# Email (optionnel)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
